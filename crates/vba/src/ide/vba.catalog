const vbGeneralNumber : Long "Format: general number"
const vbNullChar : String "A character with code 0"
const vbDefaultButton2 : Long "Message box: second button is the default"
const vbDefaultButton3 : Long "Message box: third button is the default"
const vbInteger : Long "VarType: Integer"
const vbLong : Long "VarType: Long"
const vbDouble : Long "VarType: Double"
const vbString : Long "VarType: String"
const vbBoolean : Long "VarType: Boolean"
const vbDate : Long "VarType: Date"
const vbObject : Long "VarType: Object"
const vbArray : Long "VarType: Array"
const vbEmpty : Long "VarType: Empty"
const vbNull : Long "VarType: Null"
const vbSingle : Long "VarType: Single"
const vbCurrency : Long "VarType: Currency"
const vbByte : Long "VarType: Byte"
const vbError : Long "VarType: Error"
const vbVariant : Long "VarType: Variant"
const vbNormal : Long "File attribute: normal"
const vbDirectory : Long "File attribute: folder"
const vbHidden : Long "File attribute: hidden"
const vbReadOnly : Long "File attribute: read-only"
const vbSystem : Long "File attribute: system"
const vbArchive : Long "File attribute: archive"

# ---- built-in objects
class Debug "The Immediate window"
  m Print(OutputList) "Writes to the Immediate window"
  m Assert(Condition) "Stops when the condition is False"

class Err "The last error"
  p Number : Long "The error number"
  p Description : String "The error message"
  p Source : String "Where the error came from"
  m Clear "Clears the error"
  m Raise(Number, [Source], [Description]) "Raises an error"

class Collection item=Variant "An ordered set of items"
  p Count : Long ro "How many items it has"
  p Item(Index) : Variant "An item, by position or key"
  m Add(Item, [Key], [Before], [After]) "Adds an item"
  m Remove(Index) "Removes an item"

class Dictionary item=Variant "A set of keys with their items (Scripting.Dictionary)"
  p Count : Long ro "How many keys it has"
  p Item(Key) : Variant "The item of a key"
  p CompareMode : Long "How keys are compared"
  m Add(Key, Item) "Adds a key and its item"
  m Exists(Key) : Boolean "Whether the key exists"
  m Items : Variant "All the items"
  m Keys : Variant "All the keys"
  m Remove(Key) "Removes a key"
  m RemoveAll "Removes every key"
