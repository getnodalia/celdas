# The VBA language's own library: what an editor offers beside the keywords. One line per name;
# the grammar is in `catalog.rs`. Every function here is one the interpreter runs.

# ---- strings
fn Asc(String) : Long "The character code of the first character"
fn AscW(String) : Long "The Unicode value of the first character"
fn Chr(CharCode) : String "The character with this code"
fn ChrW(CharCode) : String "The Unicode character with this code"
fn Format(Expression, [Format], [FirstDayOfWeek], [FirstWeekOfYear]) : String "Formats a value with a number, date or text format"
fn FormatNumber(Expression, [NumDigitsAfterDecimal], [IncludeLeadingDigit], [UseParensForNegativeNumbers], [GroupDigits]) : String "Formats a number with a fixed count of decimals"
fn FormatPercent(Expression, [NumDigitsAfterDecimal]) : String "Formats a number as a percentage"
fn InStr([Start], String1, String2, [Compare]) : Long "The position of String2 inside String1, or 0"
fn InStrRev(StringCheck, StringMatch, [Start], [Compare]) : Long "The position of a text, searching from the end"
fn Join(SourceArray, [Delimiter]) : String "Joins the items of an array into one text"
fn LCase(String) : String "The text in lower case"
fn Left(String, Length) : String "The first characters of a text"
fn Len(Expression) : Long "The number of characters of a text"
fn LTrim(String) : String "The text without leading spaces"
fn Mid(String, Start, [Length]) : String "Characters from the middle of a text"
fn Replace(Expression, Find, Replace, [Start], [Count], [Compare]) : String "Replaces every occurrence of a text"
fn Right(String, Length) : String "The last characters of a text"
fn RTrim(String) : String "The text without trailing spaces"
fn Space(Number) : String "A text of spaces"
fn Split(Expression, [Delimiter], [Limit], [Compare]) : Variant "Splits a text into an array"
fn StrComp(String1, String2, [Compare]) : Long "Compares two texts: -1, 0 or 1"
fn String(Number, Character) : String "A text that repeats a character"
fn StrReverse(Expression) : String "The text backwards"
fn Trim(String) : String "The text without leading and trailing spaces"
fn UCase(String) : String "The text in upper case"
fn Str(Number) : String "A number as text, with a space for the sign"

# ---- conversion
fn CBool(Expression) : Boolean "Converts to Boolean"
fn CByte(Expression) : Byte "Converts to Byte"
fn CCur(Expression) : Currency "Converts to Currency"
fn CDate(Expression) : Date "Converts to Date"
fn CDbl(Expression) : Double "Converts to Double"
fn CDec(Expression) : Variant "Converts to Decimal"
fn CInt(Expression) : Integer "Converts to Integer, rounding"
fn CLng(Expression) : Long "Converts to Long, rounding"
fn CSng(Expression) : Single "Converts to Single"
fn CStr(Expression) : String "Converts to String"
fn CVar(Expression) : Variant "Converts to Variant"
fn CVErr(ErrorNumber) : Variant "A cell error value"
fn Hex(Number) : String "A number in hexadecimal"
fn Oct(Number) : String "A number in octal"
fn Val(String) : Double "The number a text starts with"

# ---- math
fn Abs(Number) : Double "The absolute value"
fn Atn(Number) : Double "The arctangent"
fn Cos(Number) : Double "The cosine"
fn Exp(Number) : Double "e raised to a power"
fn Fix(Number) : Variant "The integer part of a number, towards zero"
fn Int(Number) : Variant "The largest integer not greater than the number"
fn Log(Number) : Double "The natural logarithm"
fn Randomize([Number]) "Seeds the random number generator"
fn Rnd([Number]) : Single "A random number from 0 up to 1"
fn Round(Expression, [NumDigitsAfterDecimal]) : Double "Rounds a number (half to even)"
fn Sgn(Number) : Integer "The sign of a number: -1, 0 or 1"
fn Sin(Number) : Double "The sine"
fn Sqr(Number) : Double "The square root"
fn Tan(Number) : Double "The tangent"

# ---- dates
fn Date : Date "The current date"
fn DateAdd(Interval, Number, Date) : Date "A date plus an interval"
fn DateDiff(Interval, Date1, Date2, [FirstDayOfWeek], [FirstWeekOfYear]) : Long "The number of intervals between two dates"
fn DateSerial(Year, Month, Day) : Date "A date from its parts"
fn DateValue(Date) : Date "The date of a text"
fn Day(Date) : Integer "The day of the month"
fn Hour(Time) : Integer "The hour"
fn Minute(Time) : Integer "The minute"
fn Month(Date) : Integer "The month"
fn MonthName(Month, [Abbreviate]) : String "The name of a month"
fn Now : Date "The current date and time"
fn Second(Time) : Integer "The second"
fn Time : Date "The current time"
fn Timer : Single "Seconds since midnight"
fn TimeSerial(Hour, Minute, Second) : Date "A time from its parts"
fn TimeValue(Time) : Date "The time of a text"
fn Weekday(Date, [FirstDayOfWeek]) : Integer "The day of the week"
fn WeekdayName(Weekday, [Abbreviate], [FirstDayOfWeek]) : String "The name of a weekday"
fn Year(Date) : Integer "The year"

# ---- information and flow
fn Array(ArgList) : Variant "An array made of its arguments"
fn Choose(Index, Choice1, [Choice2]) : Variant "The choice at an index"
fn IIf(Expression, TruePart, FalsePart) : Variant "One of two values, by a condition"
fn IsArray(VarName) : Boolean "Whether it is an array"
fn IsDate(Expression) : Boolean "Whether it can be a date"
fn IsEmpty(Expression) : Boolean "Whether a variable was never set"
fn IsError(Expression) : Boolean "Whether it is an error value"
fn IsMissing(ArgName) : Boolean "Whether an optional argument was left out"
fn IsNull(Expression) : Boolean "Whether it is Null"
fn IsNumeric(Expression) : Boolean "Whether it can be a number"
fn IsObject(Expression) : Boolean "Whether it is an object"
fn LBound(ArrayName, [Dimension]) : Long "The lowest index of an array"
fn UBound(ArrayName, [Dimension]) : Long "The highest index of an array"
fn TypeName(VarName) : String "The type of a value, as text"
fn VarType(VarName) : Integer "The type of a value, as a number"
fn RGB(Red, Green, Blue) : Long "A colour from its parts"
fn Environ(Expression) : String "An environment variable"
fn CreateObject(Class) : Object "A new automation object"
fn GetObject([PathName], [Class]) : Object "An existing automation object"
fn DoEvents : Integer "Lets the application process events"
fn Beep "Plays the system sound"
fn ChDrive(Drive) "Changes the current drive"
fn LenB(Expression) : Long "The number of bytes of a text"
fn MsgBox(Prompt, [Buttons], [Title]) : Long "Shows a message and returns the button pressed"
fn InputBox(Prompt, [Title], [Default]) : String "Asks for a text"

# ---- files
fn Dir([PathName], [Attributes]) : String "The first or next file that matches"
fn EOF(FileNumber) : Boolean "Whether the file has no more lines"
fn FreeFile : Integer "A free file number"
fn Kill(PathName) "Deletes a file"
fn MkDir(Path) "Creates a folder"
fn ChDir(Path) "Changes the current folder"

