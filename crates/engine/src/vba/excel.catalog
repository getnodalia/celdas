const xlXYScatterSmoothNoMarkers : Long "An Excel constant"
const xlXYScatterLines : Long "An Excel constant"
const xlXYScatterLinesNoMarkers : Long "An Excel constant"
const xlLine : Long "An Excel constant"
const xlLineMarkers : Long "An Excel constant"
const xlColumnClustered : Long "An Excel constant"
const xlColumnStacked : Long "An Excel constant"
