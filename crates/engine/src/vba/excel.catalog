# Excel's object model as Celdas runs it: what the VBA editor offers after a dot. One line per
# name; the grammar is in `celdas_vba::ide::catalog`. Only members the macro host implements are
# listed, so completion never suggests something that fails when it runs.

class Application "The Celdas application"
  p ActiveSheet : Worksheet ro "The sheet in front"
  p ActiveWorkbook : Workbook ro "The workbook in front"
  p ThisWorkbook : Workbook ro "The workbook that holds the macro"
  p ActiveCell : Range ro "The cell that is being edited"
  p Selection : Range ro "What is selected"
  p Workbooks : Workbooks ro "The open workbooks"
  p Sheets : Sheets ro "The sheets of the active workbook"
  p Worksheets : Sheets ro "The worksheets of the active workbook"
  p WorksheetFunction : WorksheetFunction ro "The worksheet functions"
  p Caller : Variant ro "What started the macro: the shape that was clicked"
  p Calculation : Long "Whether formulas recalculate by themselves"
  p ScreenUpdating : Boolean "Whether the screen redraws while the macro runs"
  p DisplayAlerts : Boolean "Whether warnings appear"
  p EnableEvents : Boolean "Whether events run"
  p StatusBar : Variant "The text of the status bar"
  p Interactive : Boolean "Whether the keyboard and mouse work"
  p Version : String ro "The version of the application"
  p Name : String ro "The name of the application"
  p UserName : String ro "The name of the person using it"
  p PathSeparator : String ro "The separator of folder names"
  m Evaluate(Name) : Variant "The value of a formula or a name"
  m Calculate "Calculates the open workbooks"
  m Range(Cell1, [Cell2]) : Range "A block of cells of the active sheet"
  m Cells([RowIndex], [ColumnIndex]) : Range "A cell of the active sheet"

class WorksheetFunction "The worksheet functions, called from a macro"

class Workbooks item=Workbook "The open workbooks"
  p Count : Long ro "How many workbooks are open"
  m Add : Workbook "Creates a workbook"

class Workbook "A workbook"
  p Name : String ro "The file name"
  p FullName : String ro "The path with the file name"
  p Path : String ro "The folder it was opened from"
  p Sheets : Sheets ro "Its sheets"
  p Worksheets : Sheets ro "Its worksheets"
  p ActiveSheet : Worksheet ro "The sheet in front"
  p Application : Application ro "The application"
  p Saved : Boolean "Whether it has no unsaved changes"
  m Activate "Brings it to the front"
  m Save "Saves it"
  m SaveAs(Filename, [FileFormat]) "Saves it with another name"
  m Close([SaveChanges], [Filename]) "Closes it"

class Sheets item=Worksheet "A collection of sheets"
  p Count : Long ro "How many sheets there are"
  m Add([Before], [After], [Count], [Type]) : Worksheet "Adds a sheet"

class Worksheet "A sheet"
  p Name : String "The name of the sheet"
  p Index : Long ro "Its position among the sheets"
  p Visible : Long "Whether it shows"
  p Parent : Workbook ro "The workbook it belongs to"
  p UsedRange : Range ro "The cells that hold something"
  p Cells : Range ro "Every cell of the sheet"
  p Rows : Range ro "Every row of the sheet"
  p Columns : Range ro "Every column of the sheet"
  p Shapes : Shapes ro "Its drawings, text boxes and charts"
  m Range(Cell1, [Cell2]) : Range "A block of cells"
  m Activate "Brings it to the front"
  m Select "Selects it"
  m Paste "Pastes the clipboard at the selection"
  m Delete "Deletes the sheet"
  m Calculate "Calculates the sheet"
  m Evaluate(Name) : Variant "The value of a formula on this sheet"

class Range item=Range "A block of cells"
  p Value : Variant "What the cells hold"
  p Value2 : Variant "What the cells hold, without date and currency types"
  p Formula : Variant "The formula, as written in A1 style"
  p FormulaR1C1 : Variant "The formula, as written in R1C1 style"
  p FormulaArray : Variant "The array formula"
  p HasFormula : Variant ro "Whether the cells hold formulas"
  p Text : String ro "The text as it shows"
  p NumberFormat : Variant "The number format"
  p Count : Long ro "How many cells, rows or columns"
  p Row : Long ro "The first row"
  p Column : Long ro "The first column"
  p Address([RowAbsolute], [ColumnAbsolute]) : String ro "The reference in A1 style"
  p Left : Double ro "The distance from the left edge of the sheet"
  p Top : Double ro "The distance from the top edge of the sheet"
  p Width : Double ro "The width"
  p Height : Double ro "The height"
  p Cells : Range ro "Its cells"
  p Rows : Range ro "Its rows"
  p Columns : Range ro "Its columns"
  p EntireRow : Range ro "The whole rows of the range"
  p EntireColumn : Range ro "The whole columns of the range"
  p CurrentRegion : Range ro "The block of data around it"
  p Font : Font ro "Its font"
  p Interior : Interior ro "Its fill"
  p Borders : Borders ro "Its borders"
  p Worksheet : Worksheet ro "The sheet it is on"
  p Parent : Worksheet ro "The sheet it is on"
  p HorizontalAlignment : Long "How the text lines up across"
  p VerticalAlignment : Long "How the text lines up down"
  p WrapText : Boolean "Whether the text wraps"
  p ShrinkToFit : Boolean "Whether the text shrinks to fit"
  p IndentLevel : Long "The indent"
  p MergeCells : Variant "Whether the cells are merged"
  p RowHeight : Double "The height of the rows"
  p ColumnWidth : Double "The width of the columns"
  m Offset([RowOffset], [ColumnOffset]) : Range "The range moved by rows and columns"
  m Resize([RowSize], [ColumnSize]) : Range "The range made bigger or smaller"
  m Range(Cell1, [Cell2]) : Range "A block of cells inside the range"
  m End(Direction) : Range "The last cell of the data in a direction"
  m Item(RowIndex, [ColumnIndex]) : Range "A cell of the range"
  m Select "Selects the range"
  m Activate "Makes the range the active cell"
  m Clear "Clears values and formats"
  m ClearContents "Clears the values and formulas"
  m ClearFormats "Clears the formats"
  m ClearComments "Clears the comments"
  m Merge([Across]) "Merges the cells"
  m UnMerge "Splits merged cells"
  m AutoFit "Fits the width or height to the content"
  m Delete([Shift]) "Deletes the cells"
  m Insert([Shift], [CopyOrigin]) "Inserts cells"
  p Hidden : Boolean "Whether the rows or columns are hidden"
  m Copy([Destination]) "Copies the range to the clipboard, or to a destination"
  m Cut([Destination]) "Cuts the range to the clipboard, or moves it to a destination"
  m PasteSpecial([Paste], [Operation], [SkipBlanks], [Transpose]) "Pastes part of what was copied"
  m FillDown "Copies the top cell down the range"
  m FillRight "Copies the left cell across the range"
  m FillUp "Copies the bottom cell up the range"
  m FillLeft "Copies the right cell across the range, leftwards"
  m Sort([Key1], [Order1], [Key2], [Type], [Order2], [Key3], [Order3], [Header]) "Sorts the range by one to three columns"
  m AutoFilter "Turns the filter arrows on or off"

class Font "The font of a range"
  p Bold : Boolean "Bold"
  p Italic : Boolean "Italic"
  p Underline : Long "Underline"
  p Strikethrough : Boolean "Strikethrough"
  p Size : Double "The size in points"
  p Name : String "The name of the font"
  p Color : Long "The colour as RGB"
  p ColorIndex : Long "The colour as a palette index"

class Interior "The fill of a range"
  p Color : Long "The colour as RGB"
  p ColorIndex : Long "The colour as a palette index"
  p Pattern : Long "The pattern"
  p PatternColor : Long "The colour of the pattern"
  p ThemeColor : Long "The theme colour"
  p TintAndShade : Double "How much lighter or darker"

class Borders item=Border "The borders of a range"
  p LineStyle : Long "The style of the line"
  p Weight : Long "The thickness"
  p Color : Long "The colour as RGB"
  p ColorIndex : Long "The colour as a palette index"

class Border "One border of a range"
  p LineStyle : Long "The style of the line"
  p Weight : Long "The thickness"
  p Color : Long "The colour as RGB"
  p ColorIndex : Long "The colour as a palette index"

class Shapes item=Shape "The drawings of a sheet"
  p Count : Long ro "How many shapes"
  m AddShape(Type, Left, Top, Width, Height) : Shape "Adds a shape"
  m AddTextbox(Orientation, Left, Top, Width, Height) : Shape "Adds a text box"
  m AddChart2([Style], [XlChartType], [Left], [Top], [Width], [Height]) : Shape "Adds a chart"

class Shape "A drawing, text box or chart"
  p Name : String "The name"
  p Left : Double "The distance from the left edge"
  p Top : Double "The distance from the top edge"
  p Width : Double "The width"
  p Height : Double "The height"
  p Visible : Long "Whether it shows"
  p OnAction : String "The macro it runs when clicked"
  p TextFrame : TextFrame ro "Its text"
  p TextFrame2 : TextFrame ro "Its text"
  p Chart : Chart ro "The chart"
  m Delete "Deletes it"
  m Select "Selects it"
  m BringToFront "Brings it to the front"
  m SendToBack "Sends it to the back"

class TextFrame "The text of a shape"
  p Characters : TextRange ro "The text"
  p TextRange : TextRange ro "The text"

class TextRange "A piece of text"
  p Text : String "The text"
  p Length : Long ro "How many characters"

class Chart "A chart"
  p HasTitle : Boolean "Whether it has a title"
  p ChartTitle : ChartTitle ro "Its title"
  p HasLegend : Boolean "Whether it has a legend"
  p ChartType : Long "The kind of chart"
  p SeriesCollection : SeriesCollection ro "Its series"
  p Parent : Shape ro "The shape that holds it"
  m Delete "Deletes it"
  m Refresh "Redraws it"

class ChartTitle "The title of a chart"
  p Text : String "The text"
  p Caption : String "The text"

class SeriesCollection item=Series "The series of a chart"
  p Count : Long ro "How many series"
  m NewSeries : Series "Adds a series"

class Series "A series of a chart"
  p Name : String "The name"
  p Values : Variant "The values"
  p XValues : Variant "The values of the horizontal axis"
  m Delete "Deletes it"

var Application : Application "The application"
var ActiveSheet : Worksheet "The sheet in front"
var ActiveWorkbook : Workbook "The workbook in front"
var ThisWorkbook : Workbook "The workbook that holds the macro"
var ActiveCell : Range "The cell that is being edited"
var Selection : Range "What is selected"
var Workbooks : Workbooks "The open workbooks"
var Sheets : Sheets "The sheets of the active workbook"
var Worksheets : Sheets "The worksheets of the active workbook"
fn Range(Cell1, [Cell2]) : Range "A block of cells of the active sheet"
fn Cells([RowIndex], [ColumnIndex]) : Range "A cell of the active sheet"
fn Rows([RowIndex]) : Range "The rows of the active sheet"
fn Columns([ColumnIndex]) : Range "The columns of the active sheet"
fn Evaluate(Name) : Variant "The value of a formula or a name"

const xlPasteAll : Long "An Excel constant"
const xlPasteFormulas : Long "An Excel constant"
const xlPasteValues : Long "An Excel constant"
const xlPasteFormats : Long "An Excel constant"
